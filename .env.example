# Explicit opt-in. Leaving GRAPH_BACKEND unset keeps capture/search source-only.
MEMORY_WORLDS_GRAPH_BACKEND=falkordb
MEMORY_WORLDS_FALKORDB_HOST=127.0.0.1
MEMORY_WORLDS_FALKORDB_PORT=16379
# MEMORY_WORLDS_FALKORDB_USERNAME=
# Required by the local graph deployment: generate 64 random hex characters.
MEMORY_WORLDS_FALKORDB_PASSWORD=
MEMORY_WORLDS_LLM_PROVIDER=openai-compatible
MEMORY_WORLDS_LLM_MODEL=your-extraction-model
MEMORY_WORLDS_LLM_BASE_URL=http://127.0.0.1:9000/v1
# MEMORY_WORLDS_LLM_API_KEY=
MEMORY_WORLDS_EMBEDDING_PROVIDER=openai-compatible
MEMORY_WORLDS_EMBEDDING_MODEL=your-embedding-model
MEMORY_WORLDS_EMBEDDING_BASE_URL=http://127.0.0.1:9001/v1
MEMORY_WORLDS_EMBEDDING_DIMENSIONS=1536
# MEMORY_WORLDS_EMBEDDING_API_KEY=
# For provider=openai, OPENAI_API_KEY is also accepted.
GRAPHITI_TELEMETRY_ENABLED=false

# Optional operator-owned remote shared spaces; see docs/sharing.md.
# MEMORY_WORLDS_MOUNTS_FILE=/private/config/mounts.json

# Optional shared-service access-token verifier. Set all three together.
# MEMORY_WORLDS_OIDC_ISSUER=https://identity.example.test
# MEMORY_WORLDS_OIDC_AUDIENCE=memory-worlds-api
# MEMORY_WORLDS_OIDC_JWKS_URL=https://identity.example.test/.well-known/jwks.json
# MEMORY_WORLDS_OIDC_ALGORITHMS=RS256
# MEMORY_WORLDS_OIDC_GROUPS_CLAIM=groups
# MEMORY_WORLDS_OIDC_GROUP_MAPPINGS={"data-team":{"TEAM_WORLD_ID":"writer"}}

# Optional experimental Neptune/OpenSearch lane: select GRAPH_BACKEND=neptune.
# See deploy/k8s/neptune.env.example and docs/deployments.md for AWS identity/networking.
# MEMORY_WORLDS_NEPTUNE_HOST=neptune-db://private-endpoint.example.test
# MEMORY_WORLDS_NEPTUNE_PORT=8182
# MEMORY_WORLDS_AOSS_HOST=collection.region.aoss.amazonaws.com
# MEMORY_WORLDS_AOSS_PORT=443
# AWS_REGION=us-west-2
