# Graphiti is the normal memory engine. Set explicit extraction/embedding models.
# Startup fails on missing configuration; backend=disabled is maintenance/recovery only.
MEMORY_WORLDS_GRAPH_BACKEND=falkordb
MEMORY_WORLDS_FALKORDB_HOST=127.0.0.1
MEMORY_WORLDS_FALKORDB_PORT=16379
# MEMORY_WORLDS_FALKORDB_USERNAME=
# Required by the local graph deployment: generate 64 random hex characters.
MEMORY_WORLDS_FALKORDB_PASSWORD=
# For the container stack, URLs must be reachable from the API container.
# A loopback URL refers to that container, not to its host.
MEMORY_WORLDS_LLM_PROVIDER=openai-compatible
MEMORY_WORLDS_LLM_MODEL=your-extraction-model
MEMORY_WORLDS_LLM_BASE_URL=http://127.0.0.1:9000/v1
# MEMORY_WORLDS_LLM_API_KEY=
MEMORY_WORLDS_EMBEDDING_PROVIDER=openai-compatible
MEMORY_WORLDS_EMBEDDING_MODEL=your-embedding-model
MEMORY_WORLDS_EMBEDDING_BASE_URL=http://127.0.0.1:9001/v1
MEMORY_WORLDS_EMBEDDING_DIMENSIONS=1536
MEMORY_WORLDS_EMBEDDING_BATCH_SIZE=1
# MEMORY_WORLDS_EMBEDDING_API_KEY=
# For provider=openai, OPENAI_API_KEY is also accepted.
GRAPHITI_TELEMETRY_ENABLED=false

# Optional explicit maintenance models; see docs/maintenance.md. No ambient model/key.
# Private TOML and api_key_file references must use protected files (mode 0600).
# MEMORY_WORLDS_MAINTENANCE_CONFIG=/private/config/maintenance.toml

# Optional operator-owned remote shared spaces; see docs/sharing.md.
# MEMORY_WORLDS_MOUNTS_FILE=/private/config/mounts.json

# Shared source/control/outbox journals; leave unset for a local SQLite authority.
# MEMORY_WORLDS_STORAGE_BACKEND=postgres
# MEMORY_WORLDS_DATABASE_URL=postgresql+psycopg://USER@HOST/memory?sslmode=verify-full
# MEMORY_WORLDS_AUTHORITY_ID=YOUR_STABLE_AUTHORITY_UUID

# Whole-authority encrypted backups; keep the 32-byte key outside the artifact directory.
# MEMORY_WORLDS_BACKUP_DIRECTORY=/private/backups/authority
# MEMORY_WORLDS_BACKUP_KEY_FILE=/private/keys/authority.key

# Shared identity, spaces and group roles use one operator-owned TOML file.
# See docs/corporate-access.md and deploy/organization/okta.toml.
# MEMORY_WORLDS_ORGANIZATION_FILE=/private/config/organization.toml

# Optional experimental Neptune/OpenSearch lane: select GRAPH_BACKEND=neptune.
# See deploy/k8s/neptune.env.example and docs/deployments.md for AWS identity/networking.
# MEMORY_WORLDS_NEPTUNE_HOST=neptune-db://private-endpoint.example.test
# MEMORY_WORLDS_NEPTUNE_PORT=8182
# MEMORY_WORLDS_AOSS_HOST=collection.region.aoss.amazonaws.com
# MEMORY_WORLDS_AOSS_PORT=443
# AWS_REGION=us-west-2
