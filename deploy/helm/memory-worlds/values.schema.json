{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "nameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 40
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 48
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9./:_-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253,
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "create",
        "name",
        "annotations"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "required": [
        "existingSecret"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "disabled",
            "falkordb",
            "neptune"
          ]
        }
      },
      "required": [
        "backend"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
        },
        "existingClaim": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "required": [
        "storageClass",
        "size",
        "existingClaim"
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)m?$"
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[EPTGMK]i?|[eE][+-]?[0-9]+)?$"
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)m?$"
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[EPTGMK]i?|[eE][+-]?[0-9]+)?$"
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "falkordb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "const": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9./:_-]+$"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9._-]+$"
            }
          },
          "required": [
            "existingSecret",
            "passwordKey"
          ]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
            },
            "existingClaim": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            }
          },
          "required": [
            "storageClass",
            "size",
            "existingClaim"
          ]
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "oneOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)m?$"
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[EPTGMK]i?|[eE][+-]?[0-9]+)?$"
                }
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "oneOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)m?$"
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[EPTGMK]i?|[eE][+-]?[0-9]+)?$"
                }
              }
            }
          }
        }
      },
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "auth",
        "persistence",
        "resources"
      ]
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mountsExistingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "tokensExistingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "required": [
        "enabled",
        "mountsExistingSecret",
        "tokensExistingSecret"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253,
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "secretName",
              "hosts"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientNamespaceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "matchLabels"
          ]
        },
        "clientPodSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "matchLabels"
          ]
        },
        "allowExternalHTTPS": {
          "type": "boolean"
        },
        "externalHTTPSCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "extraAPIEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "podSelector": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "matchLabels": {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "matchLabels"
                      ]
                    },
                    "namespaceSelector": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "matchLabels": {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "matchLabels"
                      ]
                    },
                    "ipBlock": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cidr": {
                          "type": "string",
                          "minLength": 1
                        },
                        "except": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "cidr"
                      ]
                    }
                  }
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "protocol": {
                      "enum": [
                        "TCP",
                        "UDP",
                        "SCTP"
                      ]
                    },
                    "port": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        {
                          "type": "string",
                          "minLength": 1
                        }
                      ]
                    }
                  },
                  "required": [
                    "port"
                  ]
                }
              }
            },
            "required": [
              "to",
              "ports"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "clientNamespaceSelector",
        "clientPodSelector",
        "allowExternalHTTPS",
        "externalHTTPSCIDRs",
        "extraAPIEgress"
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "replicaCount",
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "serviceAccount",
    "runtime",
    "graph",
    "persistence",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "falkordb",
    "router",
    "ingress",
    "networkPolicy",
    "tests"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Worlds Helm values",
  "allOf": [
    {
      "if": {
        "properties": {
          "graph": {
            "properties": {
              "backend": {
                "const": "falkordb"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "falkordb": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "runtime": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "graph": {
            "properties": {
              "backend": {
                "const": "neptune"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "falkordb": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "runtime": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "falkordb": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "falkordb": {
            "properties": {
              "auth": {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "router": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "router": {
            "properties": {
              "mountsExistingSecret": {
                "minLength": 1
              },
              "tokensExistingSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "className": {
                "minLength": 1
              },
              "hosts": {
                "minItems": 1
              },
              "tls": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
