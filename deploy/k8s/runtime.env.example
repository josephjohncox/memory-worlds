# Create memory-worlds-runtime with --from-env-file using a private copy.
# No provider is implied by deploying the base profile. Graph overlay needs
# every LLM/embedding value below, including explicit model choices.
# MEMORY_WORLDS_LLM_PROVIDER=openai-compatible
# MEMORY_WORLDS_LLM_MODEL=your-extraction-model
# MEMORY_WORLDS_LLM_BASE_URL=https://model.example.org/v1
# MEMORY_WORLDS_LLM_API_KEY=
# MEMORY_WORLDS_EMBEDDING_PROVIDER=openai-compatible
# MEMORY_WORLDS_EMBEDDING_MODEL=your-embedding-model
# MEMORY_WORLDS_EMBEDDING_BASE_URL=https://embeddings.example.org/v1
# MEMORY_WORLDS_EMBEDDING_API_KEY=
# MEMORY_WORLDS_EMBEDDING_DIMENSIONS=1536
# Shared identity: all three settings are required together.
# MEMORY_WORLDS_OIDC_ISSUER=https://identity.example.org
# MEMORY_WORLDS_OIDC_AUDIENCE=memory-worlds
# MEMORY_WORLDS_OIDC_JWKS_URL=https://identity.example.org/.well-known/jwks.json
# MEMORY_WORLDS_OIDC_ALGORITHMS=RS256
# MEMORY_WORLDS_OIDC_GROUPS_CLAIM=groups
# Mappings use real opaque world IDs created by the operator; names grant nothing.
# MEMORY_WORLDS_OIDC_GROUP_MAPPINGS={"synthetic-team":{"world_id":"reader"}}
