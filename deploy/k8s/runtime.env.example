# Create memory-worlds-runtime with --from-env-file using a private copy.
# Graphiti is required by the base profile. Set every provider/model value below.
# Missing configuration stops startup; no paid model provider is chosen implicitly.
MEMORY_WORLDS_LLM_PROVIDER=openai-compatible
MEMORY_WORLDS_LLM_MODEL=your-extraction-model
MEMORY_WORLDS_LLM_BASE_URL=https://model.example.org/v1
# MEMORY_WORLDS_LLM_API_KEY=
MEMORY_WORLDS_EMBEDDING_PROVIDER=openai-compatible
MEMORY_WORLDS_EMBEDDING_MODEL=your-embedding-model
MEMORY_WORLDS_EMBEDDING_BASE_URL=https://embeddings.example.org/v1
# MEMORY_WORLDS_EMBEDDING_API_KEY=
MEMORY_WORLDS_EMBEDDING_DIMENSIONS=1536
MEMORY_WORLDS_EMBEDDING_BATCH_SIZE=1
# Shared identity, spaces and group roles use one operator-owned TOML file.
# See deploy/organization/okta.toml and deploy/k8s/overlays/organization.
# MEMORY_WORLDS_ORGANIZATION_FILE=/etc/memory-worlds/organization/organization.toml
