# Experimental AWS lane. Use the base API with FalkorDB removed, not the graph
# overlay (which explicitly selects FalkorDB). See docs/deployments.md.
MEMORY_WORLDS_GRAPH_BACKEND=neptune
MEMORY_WORLDS_NEPTUNE_HOST=neptune-db://graph.example.org
MEMORY_WORLDS_NEPTUNE_PORT=8182
MEMORY_WORLDS_AOSS_HOST=search.example.org
MEMORY_WORLDS_AOSS_PORT=443
AWS_REGION=us-west-2
# Supply provider values from runtime.env.example separately. Workload identity
# supplies AWS credentials; never put long-lived access keys in this file.
# Neptune Analytics instead uses neptune-graph://your-graph-id.
