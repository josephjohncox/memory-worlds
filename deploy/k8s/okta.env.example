# Combine with explicit Graphiti provider/model configuration in runtime.env.
# All identifiers below are placeholders. The issuer is a CUSTOM authorization server.
MEMORY_WORLDS_OIDC_ISSUER=https://YOUR_OKTA_DOMAIN/oauth2/YOUR_AUTHORIZATION_SERVER_ID
MEMORY_WORLDS_OIDC_AUDIENCE=api://memory-worlds
MEMORY_WORLDS_OIDC_JWKS_URL=https://YOUR_OKTA_DOMAIN/oauth2/YOUR_AUTHORIZATION_SERVER_ID/v1/keys
MEMORY_WORLDS_OIDC_ALGORITHMS=RS256
# Restrict native applications and API scopes, using signed Okta access-token claims.
MEMORY_WORLDS_OIDC_CLIENT_IDS=YOUR_NATIVE_APPLICATION_CLIENT_ID
MEMORY_WORLDS_OIDC_CLIENT_ID_CLAIM=cid
MEMORY_WORLDS_OIDC_REQUIRED_SCOPES=memory-worlds
MEMORY_WORLDS_OIDC_SCOPES_CLAIM=scp
MEMORY_WORLDS_OIDC_GROUPS_CLAIM=groups
# Start with {} until the operator creates these shared worlds. Replace every ID.
MEMORY_WORLDS_OIDC_GROUP_MAPPINGS={"mw-company":{"COMPANY_WORLD_ID":"reader"},"mw-data-team":{"DATA_TEAM_WORLD_ID":"writer"},"mw-data-leads":{"DATA_TEAM_WORLD_ID":"manager"},"mw-incident-42":{"INCIDENT_WORLD_ID":"writer"}}
