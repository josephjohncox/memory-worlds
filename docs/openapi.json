  "components": {
    "schemas": {
      "CreateToken": {
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "User Id"
          },
          "agent_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Agent Id"
          },
          "grants": {
            "patternProperties": {
              "^[a-zA-Z0-9_-]{1,100}$": {
                "$ref": "#/components/schemas/Role"
              }
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Grants"
          },
          "admin": {
            "type": "boolean",
            "title": "Admin",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "agent_id"
        ],
        "title": "CreateToken"
      },
      "CreateWorld": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/WorldKind",
            "default": "personal"
          },
          "owner_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateWorld"
      },
      "Delivery": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "destination_mount_id": {
            "type": "string",
            "title": "Destination Mount Id"
          },
          "destination_authority_id": {
            "type": "string",
            "title": "Destination Authority Id"
          },
          "world_id": {
            "type": "string",
            "title": "World Id"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "blocked"
            ],
            "title": "State"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "delivered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivered At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "remote_episode_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remote Episode Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "destination_mount_id",
          "destination_authority_id",
          "world_id",
          "source_id",
          "user_id",
          "agent_id",
          "state",
          "attempts",
          "created_at"
        ],
        "title": "Delivery"
      },
      "Episode": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Id"
          },
          "content": {
            "type": "string",
            "maxLength": 200000,
            "minLength": 1,
            "title": "Content"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "text",
              "chatgpt",
              "pi",
              "publication"
            ],
            "title": "Source Type",
            "default": "text"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "source_entry_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Entry Id"
          },
          "parent_entry_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Entry Id"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Ref"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "project": {
            "type": "boolean",
            "title": "Project",
            "default": false
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "world_id": {
            "type": "string",
            "title": "World Id"
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "digest": {
            "type": "string",
            "title": "Digest"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "projection_state": {
            "type": "string",
            "enum": [
